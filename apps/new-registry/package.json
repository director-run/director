{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf .turbo .next node_modules",
    "dev": "dotenv -e .env next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check ./src",
    "lint:fix": "biome check ./src --write",
    "format": "bun run format:fix-classnames && bun run format:fix-all",
    "format:fix-all": "biome format --write ./src",
    "format:fix-classnames": "biome lint --fix --unsafe --only=lint/nursery/useSortedClasses ./src",
    "typecheck": "tsc --noEmit",
    "video-sync": "next-video sync -w"
  },
  "dependencies": {
    "@director.run/design": "workspace:*",
    "@director.run/utilities": "workspace:*",
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.81.5",
    "@trpc/client": "^11.4.3",
    "@trpc/react-query": "^11.4.3",
    "@trpc/server": "^11.4.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.517.0",
    "mixpanel": "^0.18.1",
    "next": "^15.2.3",
    "next-intl": "^4.3.1",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.6.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-radix": "^4.0.2",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.25.71"
  },
  "devDependencies": {
    "@director.run/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bun": "^1.2.17",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "cspell": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "tailwindcss": "^4.1.11",
    "tailwindcss-radix": "^4.0.2",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3"
  }
}
