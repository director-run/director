{
  "name": "hello-world-spa",
  "version": "1.0.0",
  "description": "A React TypeScript single page web app with React Router v7",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "bun run server/index.ts",
    "clean": "rm -rf dist/*",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "express": "^4.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.0.0",
    "react-router-dom": "^7.0.0"
  }
}
